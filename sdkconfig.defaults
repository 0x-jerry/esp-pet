# ESP32-C6 target
CONFIG_IDF_TARGET_ESP32C6=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# SPI
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# NVS (always enabled in ESP-IDF v5+)

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size (4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# mbedTLS / SSL for HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTP client (for AI API calls)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Bluetooth
CONFIG_BT_ENABLED=y

# NimBLE host stack (ESP-IDF built-in, C6 native)
CONFIG_BT_NIMBLE_ENABLED=y
# Bluedroid disabled
# CONFIG_BT_BLUEDROID_ENABLED is not set

# Controller mode: BLE only (C6 has no classic BR/EDR)
CONFIG_BT_LE_MAX_CONNECTIONS=2

# NimBLE Security Manager: Legacy + SC enabled, bonding by default
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
# Production: no debug keys
# CONFIG_BT_NIMBLE_SM_SC_DEBUG_KEYS is not set

# NimBLE host: central + observer (scanning requires observer)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# NimBLE memory tuning
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12

# USB Serial/JTAG console (avoids UART conflict with BTstack)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
