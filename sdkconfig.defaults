# ESP32-C6 target
CONFIG_IDF_TARGET_ESP32C6=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# SPI
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# NVS (always enabled in ESP-IDF v5+)

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size (4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# mbedTLS / SSL for HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTP client (for AI API calls)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Bluepad32 (BTstack-based gamepad support)
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=1
CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE=n

# Bluetooth enabled (required for BT_CONTROLLER_ONLY choice in ESP-IDF v5+)
CONFIG_BT_ENABLED=y
# BT host: controller-only (BTstack uses VHCI, no NimBLE/Bluedroid host)
CONFIG_BT_CONTROLLER_ONLY=y
# Controller: enabled (default)
CONFIG_BT_CONTROLLER_ENABLED=y
# BLE only (C6 has no classic)
CONFIG_BT_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_CTRL_BLE_MAX_CONN=2

# BTstack audio disabled (not available on C6)
CONFIG_BTSTACK_AUDIO=n

# USB Serial/JTAG console (avoids UART conflict with BTstack)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
